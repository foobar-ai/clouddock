# 环境变量模板（实际部署由 bootstrap.sh 自动生成 deploy/.env，本文件仅作参考）
# 约定：new-api 专属变量带 NEWAPI_ 前缀，magpie 专属变量带 MAGPIE_ 前缀；部署级配置不带前缀。

# ---- 部署级配置（用户输入）----
NEWAPI_DOMAIN=api.example.com  # new-api 对外域名（建议子域名，如 api.xxx.com）
CERT_MODE=http                 # http = HTTP-01（推荐）；dns = DNS API
TRAFFIC_QUOTA_GB=1024          # 月流量包额度，用于告警阈值与 tx 对账
# DNS_PROVIDER=dns_dp          # 仅 CERT_MODE=dns 时需要（acme.sh DNS API 标识）

# ---- 托管服务（用户输入）----
# NEWAPI_SQL_DSN=postgresql://postgres.xxx:password@host:5432/postgres   # Supabase PostgreSQL
# NEWAPI_REDIS_CONN_STRING=rediss://:password@host:6379                  # Upstash Redis

# ---- new-api（自动生成）----
NEWAPI_SESSION_SECRET=
NEWAPI_CRYPTO_SECRET=
NEWAPI_TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12
# SESSION_COOKIE_SECURE / SESSION_COOKIE_TRUSTED_URL 由 compose 内部写死/按 https://$DOMAIN 拼接

# ---- magpie（自动生成）----
MAGPIE_WEB_KEY=
MAGPIE_PUBLIC_URL=http://127.0.0.1:3425
